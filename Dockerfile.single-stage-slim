FROM python:3.14-slim
WORKDIR /spellbook
ENV PATH=/spellbook/.venv/bin:$PATH
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv==0.13.6 && uv sync --locked --no-cache
COPY spellbook/ ./spellbook/
CMD ["uvicorn", "--app-dir", "spellbook", "main:app", "--host", "0.0.0.0", "--port", "8000"]
